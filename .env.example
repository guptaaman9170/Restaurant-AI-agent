# ============================================================
# DineScout AI - Docker Environment Configuration
# ============================================================
# Copy this file to .env before running: docker compose up -d

# ------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Connection
# Default points to the containerized MongoDB service in docker-compose:
MONGODB_URI=mongodb://mongo:27017/restaurant-agent
# Or use MongoDB Atlas / External MongoDB:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/restaurant-agent

# Google Gemini API Key (Required for LangGraph agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Search API Key (Required for web search tools)
SEARCH_API_KEY=your_search_api_key_here

# Allowed origins for CORS (comma-separated or single)
CLIENT_URL=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------
# In Docker, Nginx acts as a reverse proxy forwarding /api to backend.
# Leave as /api when using Docker Compose.
VITE_API_URL=/api

# Host port mappings
CLIENT_PORT=3000
SERVER_PORT=5000
MONGO_PORT=27017
