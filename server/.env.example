PORT=5000
NODE_ENV=production

# For Docker Compose local MongoDB:
MONGODB_URI=mongodb://mongo:27017/restaurant-agent
# For external / MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/restaurant-agent

GEMINI_API_KEY=your_gemini_api_key_here
SEARCH_API_KEY=your_search_api_key_here

# Allowed frontend client URLs (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,http://localhost:5173